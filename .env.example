# Copy to .env.local for local development. NEVER commit real secret values.
# In Vercel: Project → Settings → Environment Variables (tick "Sensitive" for secrets).

# --- Public (safe in the browser) -------------------------------------------
NEXT_PUBLIC_SITE_URL=                      # e.g. https://personal-portfolio-two-iota-94.vercel.app
NEXT_PUBLIC_SUPABASE_URL=                  # https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=      # sb_publishable_…
NEXT_PUBLIC_TURNSTILE_SITE_KEY=            # Cloudflare Turnstile site key
NEXT_PUBLIC_LINKEDIN_URL=                  # https://www.linkedin.com/in/…

# --- Server-only secrets ----------------------------------------------------
SUPABASE_SECRET_KEY=                       # sb_secret_… (contact inserts + CV signed URLs)
TURNSTILE_SECRET_KEY=                      # Cloudflare Turnstile secret
RESEND_API_KEY=                            # re_… (contact alerts to hasibreza@gmail.com)
CONTACT_IP_SALT=                           # long random string; hashes visitor IPs
CRON_SECRET=                               # long random string; Vercel Cron sends it

# Local development can use Cloudflare's official always-pass Turnstile test keys:
#   NEXT_PUBLIC_TURNSTILE_SITE_KEY=1x00000000000000000000AA
#   TURNSTILE_SECRET_KEY=1x0000000000000000000000000000000AA
